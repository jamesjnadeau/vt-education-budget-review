node_modules/
dist/
.astro/
site/dist/
site/.astro/
coverage/
*.tsbuildinfo

# Isolated workspaces. Checkouts of this repo, never content of it -- an
# unignored worktree directory commits an entire second copy of the tree.
.claude/worktrees/
.superpowers/

.env
.env.*
!.env.example

.venv/
__pycache__/
*.pyc

.DS_Store
*.log
npm-debug.log*

# Build outputs of the pipeline. Everything here is derived from /warehouse,
# /registry and /model and is regenerated by `npm run build`. Nothing derived
# is committed -- the git history should only ever show source data changing.
build/
site/public/data/
site/src/generated/

# Timestamped correspondence sent to AOE, regenerated on every run and exactly
# reproducible from registry/corrections.yaml plus the code at any commit --
# unlike intake/, which is committed precisely because it CANNOT be
# regenerated. The durable record of what was sent is `sent_date` in the
# register itself, not these files.
derived/corrections/*.md
derived/corrections/*.csv
