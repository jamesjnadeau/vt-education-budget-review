---
/**
 * The walk of a journey ("your town → your school district → your supervisory
 * union → your group") drawn as a small route map: a dot for each stop, a dashed
 * line with an arrowhead between stops, and a "you are here" tag under the
 * current stop. Every other stop is a link. Works without JavaScript: a plain
 * ordered list of links, so the route is also readable as text.
 */
import type { Step } from '../lib/journey.ts';

interface Props {
  steps: Step[];
  current: Step['id'];
}

const { steps, current } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<nav aria-label="Your journey">
  <ol class="journey-progress">
    {steps.map((s) => {
      const isCurrent = s.id === current;
      return (
        <li class:list={['journey-progress-step', isCurrent ? 'journey-progress-step--current' : '']}>
          <span class="journey-progress-dot" aria-hidden="true" />
          <span class="journey-progress-text">
            {isCurrent ? (
              <span class="journey-progress-label" aria-current="step">{s.label}</span>
            ) : (
              <a class="journey-progress-label" href={`${base}${s.href}`}>{s.label}</a>
            )}
            {isCurrent && <span class="journey-progress-mark">you are here</span>}
          </span>
        </li>
      );
    })}
  </ol>
</nav>

<style>
  .journey-progress {
    --dot: 1.1rem;
    --gap: 0.35rem;
    --route: var(--accent);
    display: flex;
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    width: 100%;
  }
  .journey-progress-step {
    position: relative;
    flex: 1 1 0;
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    max-width: none;
  }
  .journey-progress-text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.45rem;
  }

  /* The stop */
  .journey-progress-dot {
    flex: none;
    box-sizing: border-box;
    width: var(--dot);
    height: var(--dot);
    border-radius: 50%;
    border: 3px solid var(--route);
    background: var(--surface);
  }
  .journey-progress-step--current .journey-progress-dot {
    background: var(--route);
    box-shadow: 0 0 0 3px var(--gold);
  }

  .journey-progress-label {
    font-weight: 600;
    line-height: 1.25;
    color: var(--link);
    text-decoration: underline;
    text-decoration-color: var(--gold-dark);
    text-underline-offset: 4px;
  }
  a.journey-progress-label:hover {
    color: var(--link-hover);
  }
  .journey-progress-step--current .journey-progress-label {
    color: var(--text);
    text-decoration: none;
  }

  /* The "you are here" tag, with a small pointer up to the stop */
  .journey-progress-mark {
    position: relative;
    padding: 0.1rem 0.55rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent-text);
    background: var(--route);
  }
  .journey-progress-mark::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -0.3rem;
    transform: translateX(-50%);
    border: 0.3rem solid transparent;
    border-top: 0;
    border-bottom-color: var(--route);
  }

  /* The route between stops: a dashed line ending in an arrowhead at the next stop */
  .journey-progress-step:not(:first-child)::before {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2 - 1px);
    left: calc(-50% + var(--dot) / 2 + var(--gap));
    width: calc(100% - var(--dot) - 2 * var(--gap));
    border-top: 2px dashed var(--route);
  }
  .journey-progress-step:not(:first-child)::after {
    content: '';
    position: absolute;
    top: calc(var(--dot) / 2 - 0.3rem - 1px);
    right: calc(50% + var(--dot) / 2 + var(--gap) + 0.1rem);
    width: 0.6rem;
    height: 0.6rem;
    border-top: 2px solid var(--route);
    border-right: 2px solid var(--route);
    transform: rotate(45deg);
  }

  /* Narrow screens: the route runs downward instead */
  @media (max-width: 36rem) {
    .journey-progress {
      flex-direction: column;
    }
    .journey-progress-step {
      flex-direction: row;
      align-items: flex-start;
      text-align: left;
      gap: 0.75rem;
    }
    .journey-progress-step:not(:first-child) {
      padding-top: 1.75rem;
    }
    .journey-progress-text {
      align-items: flex-start;
    }
    .journey-progress-dot {
      margin-top: 0.1rem;
    }
    .journey-progress-step:not(:first-child)::before {
      top: var(--gap);
      left: calc(var(--dot) / 2 - 1px);
      width: 0;
      height: calc(1.75rem - 2 * var(--gap));
      border-top: 0;
      border-left: 2px dashed var(--route);
    }
    .journey-progress-step:not(:first-child)::after {
      top: calc(1.75rem - var(--gap) - 0.6rem - 0.1rem);
      left: calc(var(--dot) / 2 - 0.3rem - 0.5px);
      right: auto;
      transform: rotate(135deg);
    }
    .journey-progress-mark::before {
      left: 0.8rem;
    }
  }
</style>
