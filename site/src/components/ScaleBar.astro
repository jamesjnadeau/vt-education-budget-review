---
/**
 * A horizontal bar showing a fraction (0–1, e.g. a town's share of a union).
 * The value is always stated as visible text, never meaning by length alone.
 */
interface Props {
  fraction: number;
  caption: string;
}

const { fraction, caption } = Astro.props;
const pct = Math.round(fraction * 100);
---

<div class="journey-scalebar">
  <div class="journey-scalebar-track" role="img" aria-label={`${caption}: ${pct} percent`}>
    <span class="journey-scalebar-fill" style={`width:${pct}%`} />
  </div>
  <p class="journey-caption">{caption}</p>
</div>
