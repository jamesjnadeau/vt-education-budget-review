---
/**
 * Three headline figures for one journey step: tax rate, students, people.
 *
 * The rule that matters: a figure that cannot be shown is never shown as a
 * number or an estimate. A `blank` renders its plain reason and a status tag;
 * a student sum that is a range renders as "at least N" / "N to M", never a
 * single invented number.
 */
import { count, bound, type Cell } from '../lib/residents.ts';
import type { Figure, Students } from '../lib/journey.ts';

interface Props {
  rate: Figure<number>;
  students: Students;
  people: Figure<number>;
  rateLabel: string;
  studentsLabel: string;
  peopleLabel: string;
}

const { rate, students, people, rateLabel, studentsLabel, peopleLabel } = Astro.props;

const blankTag: Record<string, string> = {
  missing_input: 'not published',
  unverified: 'not checked yet',
  undetermined: 'not decided yet',
  not_computable: 'cannot be told',
};

function boundRange(low: number, high: number | null): string {
  if (high === null) return `at least ${count(low)} students`;
  return `${count(low)} to ${count(high)} students`;
}
---

<div class="journey-stats">
  <article class="journey-stat">
    <h3 class="journey-stat-heading">{rateLabel}</h3>
    {
      rate.kind === 'value' ? (
        <p class="journey-stat-figure" data-type="number">{rate.value.toLocaleString('en-US', { maximumFractionDigits: 4 })}</p>
      ) : (
        <div class="journey-stat-blank">
          <span class={`tag ${rate.why}`}>{blankTag[rate.why]}</span>
          <p class="muted">{rate.reason}</p>
        </div>
      )
    }
  </article>

  <article class="journey-stat">
    <h3 class="journey-stat-heading">{studentsLabel}</h3>
    {
      students.kind === 'sum'
        ? students.sum.kind === 'exact' ? (
            <p class="journey-stat-figure" data-type="number">{count(students.sum.value)}</p>
          ) : students.sum.kind === 'range' ? (
            <p class="journey-stat-figure">{boundRange(students.sum.low, students.sum.high)}</p>
          ) : students.sum.kind === 'none' ? (
            <div class="journey-stat-blank">
              <span class="tag not-computable">cannot be told</span>
              <p class="muted">No students are counted as living here.</p>
            </div>
          ) : (
            <div class="journey-stat-blank">
              <span class="tag not-computable">cannot be told</span>
              <p class="muted">The state did not publish usable student counts for this place this year.</p>
            </div>
          )
        : (
          <div class="journey-stat-blank">
            <span class="tag not-computable">cannot be told</span>
            <p class="muted">{students.reason}</p>
          </div>
        )
    }
  </article>

  <article class="journey-stat">
    <h3 class="journey-stat-heading">{peopleLabel}</h3>
    {
      people.kind === 'value' ? (
        <p class="journey-stat-figure" data-type="number">{count(people.value)}</p>
      ) : (
        <div class="journey-stat-blank">
          <span class={`tag ${people.why}`}>{blankTag[people.why]}</span>
          <p class="muted">{people.reason}</p>
        </div>
      )
    }
  </article>
</div>
