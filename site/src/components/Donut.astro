---
/**
 * A donut chart for one share (0–1), e.g. a town's part of its district's
 * students. The percentage is always written in the middle and in the aria-label,
 * so the ring is never the only carrier of the figure.
 */
import { percentText } from '../lib/journey-scale.ts';

interface Props {
  fraction: number;
  /** What the share is of, read after the percentage: "of the students in your school district". */
  caption: string;
}

const { fraction, caption } = Astro.props;
const clamped = Math.max(0, Math.min(1, fraction));
const full = percentText(clamped);
const centre = full === 'less than 1%' ? '<1%' : full;
const arc = clamped * 100;
---

<figure class="journey-donut">
  <div class="journey-donut-chart">
    <svg viewBox="0 0 100 100" role="img" aria-label={`${full} ${caption}`}>
      <circle class="journey-donut-track" cx="50" cy="50" r="40" pathLength="100" />
      {arc > 0 && (
        <circle
          class="journey-donut-arc"
          cx="50"
          cy="50"
          r="40"
          pathLength="100"
          stroke-dasharray={`${arc} ${100 - arc}`}
        />
      )}
    </svg>
    <span class="journey-donut-value" aria-hidden="true">{centre}</span>
  </div>
  <figcaption class="journey-donut-caption">{caption}</figcaption>
</figure>
