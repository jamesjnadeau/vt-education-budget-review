---
/**
 * A page at an address from before the year was part of it. Sends the visitor
 * to the same place in the default year, and says so in a link for anyone
 * whose browser does not follow the refresh.
 */
import Base from '../layouts/Base.astro';
import { DEFAULT_YEAR, myHref, type JourneyKind } from '../lib/years.ts';

interface Props {
  kind: JourneyKind;
  slug: string | number;
  name: string;
}

const { kind, slug, name } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const to = `${base}${myHref(DEFAULT_YEAR, kind, slug)}`;
---

<Base title={`${name} — Vermont School Budgets`}>
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <meta name="robots" content="noindex" />
  </Fragment>
  <h1>{name}</h1>
  <p>This page has moved. <a href={to}>See {name} for fiscal year {DEFAULT_YEAR}.</a></p>
</Base>
