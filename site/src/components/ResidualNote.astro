---
/**
 * A short note for the eleven districts whose rate this site's math does not
 * reproduce. It gives the reason, says the State's rate is shown, and links to
 * the write-up.
 */
interface Props {
  reason: string;
}

const { reason } = Astro.props;
const DOC = 'https://github.com/jamesjnadeau/vt-education-budget-review/blob/main/docs/act-127-transition.md';
---

<p class="residual-note">
  {reason} The State's published rate is shown. <a href={DOC}>Read how we checked</a>.
</p>

<style>
  .residual-note {
    font-size: 0.9rem;
    color: var(--text-muted);
    margin: 0.5rem 0 1rem;
  }
</style>
