---
/**
 * A line chart of one town's homestead tax rate across the fiscal years on
 * file. Each year is a point linking to that year's page; the current year is
 * filled in the accent colour. A year with no published rate is a gap (the line
 * breaks) and is listed in the caption, never silently dropped. Every value is
 * also in the point's label, so nothing rests on position or colour alone.
 */
import { DEFAULT_YEAR, myHref } from '../lib/years.ts';

interface Props {
  townName: string;
  slug: string;
  /** The page's own year. */
  year: number;
  /** One entry per fiscal year, oldest first; rate is null when none was published. */
  series: { year: number; rate: number | null }[];
}

const { townName, slug, year, series } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const W = 900;
const H = 240;
const M = { top: 18, right: 22, bottom: 34, left: 52 };
const PAD = 28; // keeps the first and last labels clear of the axis
const iw = W - M.left - M.right - PAD * 2;
const ih = H - M.top - M.bottom;

const known = series.filter((p) => p.rate !== null) as { year: number; rate: number }[];
const missing = series.filter((p) => p.rate === null).map((p) => p.year);
const fmt = (v: number) => v.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 4 });

let lo = 0;
let hi = 1;
if (known.length > 0) {
  const min = Math.min(...known.map((p) => p.rate));
  const max = Math.max(...known.map((p) => p.rate));
  const pad = Math.max((max - min) * 0.15, 0.05);
  lo = Math.max(0, Math.floor((min - pad) * 10) / 10);
  hi = Math.ceil((max + pad) * 10) / 10;
  if (hi - lo < 0.2) hi = lo + 0.2;
}
const ticks = Array.from({ length: 5 }, (_, i) => lo + ((hi - lo) * i) / 4);

const x = (i: number) => M.left + PAD + (series.length === 1 ? iw / 2 : (iw * i) / (series.length - 1));
const y = (v: number) => M.top + ih - ((v - lo) / (hi - lo)) * ih;

const points = series.map((p, i) => ({ ...p, cx: x(i), cy: p.rate === null ? null : y(p.rate) }));

// Runs of consecutive years with a rate; a gap year ends the run so the line breaks.
const runs: { cx: number; cy: number }[][] = [];
for (const p of points) {
  if (p.cy === null) {
    runs.push([]);
  } else {
    if (runs.length === 0) runs.push([]);
    runs[runs.length - 1].push({ cx: p.cx, cy: p.cy });
  }
}
const paths = runs.filter((r) => r.length > 1).map((r) => r.map((q, i) => `${i === 0 ? 'M' : 'L'}${q.cx.toFixed(1)},${q.cy.toFixed(1)}`).join(' '));

const first = known[0];
const last = known[known.length - 1];
const summary =
  known.length > 1
    ? `${townName}'s homestead tax rate went from ${fmt(first.rate)} in FY${first.year} to ${fmt(last.rate)} in FY${last.year}, per $100 of property value.`
    : known.length === 1
      ? `${townName}'s homestead tax rate was ${fmt(first.rate)} in FY${first.year}, per $100 of property value.`
      : `No homestead tax rate is on file for ${townName}.`;
---

<figure class="rate-history">
  <figcaption class="rate-history-title">Homestead tax rate by fiscal year</figcaption>
  {known.length === 0 ? (
    <p class="blank-reason">The state has not published a homestead tax rate for this town in any year on file.</p>
  ) : (
    <div class="rate-history-scroll" tabindex="0" role="region" aria-label="Homestead tax rate chart (scrolls sideways on narrow screens)">
    <svg viewBox={`0 0 ${W} ${H}`} role="group" aria-label={summary} class="rate-history-svg">
      {ticks.map((t) => (
        <g>
          <line x1={M.left} x2={W - M.right} y1={y(t)} y2={y(t)} class="rate-history-grid" />
          <text x={M.left - 8} y={y(t)} class="rate-history-tick" text-anchor="end" dominant-baseline="middle">{t.toFixed(2)}</text>
        </g>
      ))}
      {paths.map((d) => <path d={d} class="rate-history-line" />)}
      {points.map((p) => (
        <g>
          <text x={p.cx} y={H - 12} class:list={['rate-history-year', p.year === year && 'is-current']} text-anchor="middle">{p.year}</text>
          {p.cy !== null && p.rate !== null && (
            <a href={`${base}${myHref(p.year, 'town', slug)}`} aria-label={`FY${p.year}: ${fmt(p.rate)}${p.year === year ? ' (this page)' : ''}`} aria-current={p.year === year ? 'page' : undefined}>
              <title>{`FY${p.year}: ${fmt(p.rate)}`}</title>
              <circle cx={p.cx} cy={p.cy} r="14" class="rate-history-hit" />
              <circle cx={p.cx} cy={p.cy} r={p.year === year ? 6 : 4.5} class:list={['rate-history-dot', p.year === year && 'is-current', p.year > DEFAULT_YEAR && 'is-later']} />
              <text x={p.cx} y={p.cy - (p.year === year ? 15 : 11)} class:list={['rate-history-value', p.year === year && 'is-current']} text-anchor="middle">{fmt(p.rate)}</text>
            </a>
          )}
        </g>
      ))}
    </svg>
    </div>
  )}
  <p class="journey-caption">
    Dollars of tax per $100 of property value, for a home. Select a year to see this town that year.
    {missing.length > 0 && ` No rate was published for FY${missing.join(', FY')}.`}
    {series.some((p) => p.year > DEFAULT_YEAR && p.rate !== null) && ` Hollow dots are years whose figures are not complete yet.`}
  </p>
</figure>

<style>
  .rate-history {
    margin: 0 0 1rem;
  }
  .rate-history-title {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }
  /* Under 40rem the chart keeps a readable size and scrolls sideways instead of shrinking its text. */
  .rate-history-scroll {
    overflow-x: auto;
  }
  .rate-history-svg {
    min-width: 36rem;
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .rate-history-grid {
    stroke: var(--border, #ccc);
    stroke-width: 1;
  }
  .rate-history-tick,
  .rate-history-year {
    font-size: 11px;
    fill: var(--text-muted);
  }
  .rate-history-year.is-current {
    fill: var(--text, currentColor);
    font-weight: 700;
  }
  .rate-history-line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .rate-history-dot {
    fill: var(--accent);
    stroke: var(--surface, #fff);
    stroke-width: 1.5;
  }
  .rate-history-dot.is-current {
    stroke: var(--text, #000);
    stroke-width: 2;
  }
  .rate-history-dot.is-later {
    fill: var(--surface, #fff);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .rate-history-hit {
    fill: transparent;
  }
  .rate-history-value {
    font-size: 11px;
    fill: var(--text-muted);
  }
  .rate-history-value.is-current {
    fill: var(--text, currentColor);
    font-weight: 700;
  }
  a:focus-visible .rate-history-dot {
    stroke: var(--text, #000);
    stroke-width: 3;
  }
</style>
