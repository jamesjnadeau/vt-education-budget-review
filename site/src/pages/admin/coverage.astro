---
import Base from '../../layouts/Base.astro';
import coverage from '../../generated/coverage.json';
import { slugTail, titleCase } from '../../lib/display';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Cell {
  entity: string;
  entityName: string;
  fiscalYear: number;
  state: 'normalized' | 'intake_only' | 'not_published' | 'missing';
  warehouseFile: string | null;
  intakeFiles: string[];
  lastKnownSource: string | null;
  intakeUrl: string | null;
  normalizeUrl: string | null;
  flagUrl: string | null;
  notPublishedNote: string | null;
}

const cells = coverage.cells as Cell[];
const years = coverage.fiscalYears as number[];
const entities = coverage.entities as Array<{ slug: string; name: string; priority: number | null }>;

const cellFor = (slug: string, year: number) =>
  cells.find((c) => c.entity === slug && c.fiscalYear === year);

const LABEL: Record<Cell['state'], string> = {
  normalized: 'entered and ready',
  intake_only: 'uploaded, not entered yet',
  not_published: 'confirmed not published',
  missing: 'missing',
};
---

<Base title="What we have — Vermont School Budgets">
  <h1>What we have</h1>
  <p class="lede">
    Which budget documents this site has, and which it does not. We show this in the open rather
    than keeping it inside, because a site that shows what it is missing is easier to trust than
    one that only shows what it has.
  </p>

  <div class="notice">
    <strong>Grey and red are different facts</strong>
    <p>
      <em>Confirmed not published</em> means someone checked and the district put out no budget
      document that year, with a record of who checked and when. <em>Missing</em> means we just
      don't have it — maybe it exists and no one has collected it yet, or maybe no one has looked.
      Treating the two as the same would make the top coverage number meaningless.
    </p>
  </div>

  <ul class="legend">
    <li><span class="swatch" style="background:var(--state-normalized)"></span> Held ({coverage.totals.normalized})</li>
    <li><span class="swatch" style="background:var(--state-intake)"></span> Uploaded, not entered yet ({coverage.totals.intake_only})</li>
    <li><span class="swatch" style="background:var(--state-absent)"></span> Confirmed not published ({coverage.totals.not_published})</li>
    <li><span class="swatch" style="background:var(--state-missing)"></span> Missing ({coverage.totals.missing})</li>
  </ul>

  <p>
    We hold and have entered {coverage.totals.normalized} of the {cells.length} supervisory-union
    years we expect. Made {coverage.generated}.
  </p>

  <div class="scroll-x">
    <table class="coverage">
      <caption class="visually-hidden">Budget coverage by supervisory union and fiscal year</caption>
      <thead>
        <tr>
          <th scope="col">Supervisory union</th>
          {years.map((y) => <th scope="col">FY{String(y).slice(2)}</th>)}
        </tr>
      </thead>
      <tbody>
        {
          entities.map((entity) => (
            <tr>
              <th scope="row">
                <a href={`${base}/su/${slugTail(entity.slug)}/`}>{titleCase(entity.name)}</a>
              </th>
              {years.map((year) => {
                const cell = cellFor(entity.slug, year);
                if (!cell) return <td />;
                const title = `${titleCase(entity.name)} FY${year}: ${LABEL[cell.state]}`;
                const href = cell.warehouseFile
                  ? null
                  : (cell.normalizeUrl ?? cell.intakeUrl ?? cell.flagUrl ?? null);
                const linkText =
                  cell.state === 'intake_only'
                    ? 'enter it'
                    : cell.state === 'missing'
                      ? 'send in'
                      : LABEL[cell.state];
                return (
                  <td>
                    {href ? (
                      <a class={`cell ${cell.state}`} href={href} title={title}>
                        {linkText}
                      </a>
                    ) : (
                      <span class={`cell ${cell.state}`} title={title}>
                        {cell.state === 'normalized' ? 'held' : LABEL[cell.state]}
                      </span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <h2>How to send a budget in</h2>
  <p>
    There is no login, because there is no server. Every red box above opens a short form, already
    filled in with the supervisory union and year. Drag the PDF or spreadsheet in, say where it
    came from, and send it — no checkout, no code tools, no account beyond a GitHub login.
  </p>
  <p>
    A bot takes it from there. It checks the form, makes a fingerprint of the exact file you sent,
    and opens a request to add the file and a record of where it came from. The save is the bot's,
    with you credited as a co-author — a little weaker than a save in your own name, and the fair
    trade for a source record that is checked by machine instead of typed by hand. If something is
    wrong, the bot comments on your report to say what, and checks again when you fix it.
  </p>
  <p>
    Two things matter most: <strong>send the document exactly as the district put it out</strong> —
    do not crop, re-save, or change its format — and <strong>say where it came from</strong>.
    If you would rather just point out a gap than send a file, the missing boxes also open a
    ready-made report for that.
  </p>

  {
    coverage.totals.missing === cells.length && (
      <div class="notice blocking">
        <strong>Everything is missing, and that is accurate</strong>
        <p>
          No budget documents have been collected yet. The system that would clean them up, check
          them, and publish them is built and tested — what it lacks is documents. Each supervisory
          union has a collector setup that records where to start looking.
        </p>
      </div>
    )
  }
</Base>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
