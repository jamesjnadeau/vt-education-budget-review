---
import Base from '../../layouts/Base.astro';
import groupings from '../../generated/groupings.json';
import {
  committeeMoves,
  dissolvedGroups,
  longDate,
  publishedCommittees,
  settleDatePassedUnconfirmed,
  unlistedActMembers,
  type Reassignment,
} from '../../lib/groupings.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Grouping {
  number: number;
  slug: string;
  name: string;
  members: string[];
  member_names_as_written?: string[];
  verified: boolean;
}

const doc = groupings as {
  status: string;
  act: { name: string; citation: { statute: string; verified: boolean }; text_url: string | null };
  reassignment?: Reassignment | null;
  groupings: Grouping[];
};

// The facilitators' committees, once their list is in; the act's groups
// otherwise. Moves are read off by comparing the two. See site/src/lib/groupings.ts.
const moved = doc.reassignment ?? null;
const committees = publishedCommittees(moved);
const moves = committeeMoves(doc.groupings, committees);
const dissolved = dissolvedGroups(doc.groupings, committees);
const unlisted = unlistedActMembers(doc.groupings, committees);
const sources = moved?.sources ?? [];
const settleUnconfirmed = settleDatePassedUnconfirmed(moved, new Date().toISOString().slice(0, 10));
const districtCount = (c: (typeof committees)[number]) => c.roster.filter((l) => l.kind === 'district').length;
const fmt = (n: number) => n.toLocaleString('en-US');
const andList = (xs: string[]) =>
  xs.length <= 1 ? (xs[0] ?? '') : `${xs.slice(0, -1).join(', ')} and ${xs[xs.length - 1]}`;
---

<Base title="Merger study groups — Vermont School Budgets">
  <h1>Merger study groups</h1>
  {committees.length > 0 ? (
    <p class="lede">
      {doc.act?.name ?? 'Act 170'} put Vermont's school districts into {doc.groupings.length} groups.
      Each group studies whether its districts should join into one. The law let the people the state
      hired to run these talks, the {moved?.by}, change the groups. On {longDate(moved?.as_of)} they
      did. There are now {committees.length} groups. These are the starting what-ifs in the tool.
    </p>
  ) : (
    <p class="lede">
      The groups of school districts named in {doc.act?.name ?? 'Act 170'}. These are the starting
      what-ifs in the tool.
    </p>
  )}

  {committees.length > 0 && moved?.status === 'announced_provisional' && (
    <div class="notice">
      <strong>This is the first list, not the final one</strong>
      <details class="notice-more">
        <summary>show more information</summary>
        <p>
          The {moved.by} called this list "a starting point, not a final decision." School boards
          could send comments until {longDate(moved.comment_deadline)}. The plan was to settle the
          groups by {longDate(moved.finalize_target)}.
          {settleUnconfirmed && <span> We have not seen a final list yet, so a few groups may have changed since.</span>}
        </p>
        <p>
          A computer copied this list from the press release. A person has not checked it line by
          line yet. That is why each group says "not checked."
        </p>
      </details>
    </div>
  )}

  {committees.length > 0 ? (
    <ul class="grid">
      {committees.map((c) => (
        <li class="card">
          <h3 style="margin-top:0">
            <a href={`${base}/groupings/${c.number}/`}>{c.name}</a>
          </h3>
          <p style="margin:.3rem 0 0;font-size:.9rem;color:var(--text-muted)">
            {c.region && <span>{c.region} · </span>}
            {districtCount(c)} district(s)
            {c.adm_total_as_published != null && <span> · {fmt(c.adm_total_as_published)} students</span>}
            {!c.verified && <span class="tag unverified" style="margin-left:.5rem">not checked</span>}
          </p>
        </li>
      ))}
    </ul>
  ) : doc.groupings.length === 0 ? (
    <div class="notice blocking">
      <strong>Not typed in yet</strong>
      <details class="notice-more">
        <summary>show more information</summary>
        <p>
          This list is empty because we have not typed the groups in yet — not because the law has
          none. Any name we cannot match will be listed, not dropped.
        </p>
      </details>
    </div>
  ) : (
    <ul class="grid">
      {doc.groupings.map((g) => (
        <li class="card">
          <h3 style="margin-top:0">
            <a href={`${base}/groupings/${g.number}/`}>{g.number}. {g.name}</a>
          </h3>
          <p style="margin:.3rem 0 0;font-size:.9rem;color:var(--text-muted)">
            {g.members.length} district(s)
            {!g.verified && <span class="tag unverified" style="margin-left:.5rem">not checked</span>}
          </p>
        </li>
      ))}
    </ul>
  )}

  {committees.length > 0 && (
    <>
      <p style="font-size:.9rem;color:var(--text-muted)">
        "Students" is the state's count of students who live in each district, averaged over two
        years (ADM). The numbers are the ones printed on the list.
      </p>

      <h2>What changed from the law</h2>
      {dissolved.length > 0 && (
        <p>
          <strong>
            {dissolved.length === 1 ? 'Group ' : 'Groups '}
            {andList(dissolved.map(String))} {dissolved.length === 1 ? 'is' : 'are'} gone.
          </strong>{' '}
          After some districts asked to leave, too few students were left to meet the law's
          2,000-student floor. So the rest of the districts were sent to other groups. The other
          groups kept their numbers from the law.
        </p>
      )}
      {moves.length > 0 && (
        <>
          <p>These districts are now in a different group than the law put them in:</p>
          <ul>
            {moves.map((m) => (
              <li>
                <strong>{m.name}</strong> moved from{' '}
                <a href={`${base}/groupings/${m.from_grouping}/`}>group {m.from_grouping}</a> to{' '}
                <a href={`${base}/groupings/${m.to_grouping}/`}>group {m.to_grouping}</a>.
              </li>
            ))}
          </ul>
        </>
      )}
      {unlisted.map((u) => (
        <p>
          The law put <strong>{u.name}</strong> in group {u.from_grouping}. The new list does not name it.
          {u.slug.startsWith('su/') && <span> It names the districts in it instead, so we do not count this as a move.</span>}
        </p>
      ))}
    </>
  )}

  <h2>Where this comes from</h2>
  <dl class="facts">
    <dt>Law</dt>
    <dd>{doc.act?.citation?.statute ?? '—'}</dd>
    <dt>Law's groups checked against the law</dt>
    <dd>
      {doc.act?.citation?.verified ? 'yes' : <span class="tag unverified">not checked yet</span>}
    </dd>
  </dl>
  {sources.length > 0 && (
    <ul style="font-size:.9rem">
      {sources.map((s) => (
        <li>
          <a href={s.url}>{s.publisher}, "{s.title}"</a>, {longDate(s.published_date)}
        </li>
      ))}
    </ul>
  )}
  {committees.length > 0 && (
    <p style="font-size:.9rem;color:var(--text-muted)">
      The first link is the {moved?.by}'s own press release with the full list. We got our copy from
      The Chester Telegraph's website. The others are news reports from before we had the list.
    </p>
  )}
</Base>
