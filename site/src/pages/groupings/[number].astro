---
import Base from '../../layouts/Base.astro';
import groupingsDoc from '../../generated/groupings.json';
import groupingBudgets from '../../generated/grouping-budgets.json';
import { createContext, runScenario, defaultAssumptions, formatValue } from '@vt-budget/model';
import type { DistrictBudget } from '@vt-budget/model';
import {
  committeeAdmSum,
  committeeMoves,
  longDate,
  publishedCommittees,
  unlistedActMembers,
  whereMembersWent,
  type Committee,
  type Reassignment,
} from '../../lib/groupings.ts';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Grouping {
  number: number;
  slug: string;
  name: string;
  members: string[];
  member_names_as_written?: string[];
  verified: boolean;
}
interface GroupingBudgetMember {
  slug: string;
  name_as_written: string | null;
  budget: DistrictBudget | null;
  resolution: 'direct' | 'via_su' | 'missing' | 'ambiguous';
  fiscal_year: number | null;
  status: string | null;
  spending_basis: 'budget' | 'aoe_edspend' | null;
  pupils: { value: number; measure: string; fiscal_year: number } | null;
}
interface GroupingBudgets {
  number: number;
  slug: string;
  name: string;
  members: GroupingBudgetMember[];
  resolved_count: number;
  member_count: number;
  fiscal_years_present: number[];
}

const doc = groupingsDoc as {
  act?: { name?: string; citation?: { statute?: string } };
  reassignment?: Reassignment | null;
  groupings: Grouping[];
};
const budgetsByNumber = new Map(
  (groupingBudgets as GroupingBudgets[]).map((g) => [g.number, g]),
);

// One page per act group number. The committees kept the act's numbers, so a
// committee shares its page with the act group of the same number; an act group
// with no committee (dissolved) still gets a page saying where its districts went.
export function getStaticPaths() {
  const source = groupingsDoc as { groupings: Grouping[] };
  return source.groupings.map((g) => ({ params: { number: String(g.number) }, props: { grouping: g } }));
}

const { grouping } = Astro.props as { grouping: Grouping };
const moved = doc.reassignment ?? null;
const committees = publishedCommittees(moved);
const committee: Committee | null = committees.find((c) => c.number === grouping.number) ?? null;
const dissolved = committees.length > 0 && committee === null;
const title = committee?.name ?? grouping.name;
const budgets = budgetsByNumber.get(grouping.number) ?? {
  number: grouping.number,
  slug: grouping.slug,
  name: grouping.name,
  members: [],
  resolved_count: 0,
  member_count: grouping.members.length,
  fiscal_years_present: [],
};

// The combined total is only stated when every member resolved to a non-null
// total. A resolved record whose total is null (published nothing) is still a
// gap, because null propagates through the model to an unknown current total.
const computable =
  budgets.member_count > 0 &&
  budgets.members.length > 0 &&
  budgets.members.every((m) => m.budget && m.budget.education_spending !== null);

let result: ReturnType<typeof runScenario> | null = null;
if (computable) {
  const ctx = createContext({
    fiscal_year: budgets.fiscal_years_present[0] ?? 0,
    status: 'draft',
    note: null,
    parameters: new Map(),
    inputs: new Map(),
  });
  result = runScenario(ctx, {
    name: grouping.name,
    districts: budgets.members.map((m) => m.budget as DistrictBudget),
    assumptions: defaultAssumptions(),
  });
}

// What changed against the act's group, read off the committees.
const allMoves = committeeMoves(doc.groupings, committees);
const movedIn = allMoves.filter((m) => m.to_grouping === grouping.number);
const movedOut = allMoves.filter((m) => m.from_grouping === grouping.number);
const unlistedHere = unlistedActMembers(doc.groupings, committees).filter((u) => u.from_grouping === grouping.number);
const techCenters = committee?.roster.filter((l) => l.kind === 'career_technical_center') ?? [];
const rosterDistricts = committee?.roster.filter((l) => l.kind === 'district') ?? [];
const admSum = committee ? committeeAdmSum(committee) : null;
const admMismatch =
  committee?.adm_total_as_published != null && admSum !== null && admSum !== committee.adm_total_as_published;
const listSource = moved?.sources.find((s) => s.publisher === moved.by) ?? null;
const fmt = (n: number) => n.toLocaleString('en-US');
// Where each of a dissolved group's districts went, by the act's names.
const wentTo = dissolved
  ? whereMembersWent(grouping, committees).map((w) => ({ name: w.name, to: w.committee }))
  : [];

const gaps = budgets.members.filter((m) => !m.budget || m.budget.education_spending === null);
// Pupils are AOE's count: long-term weighted ADM from FY2025 (a weighted count,
// not a head count), equalized pupils before. A combined figure is stated only
// when every member has one and they are all the same measure.
const pupilMeasures = [...new Set(budgets.members.map((m) => m.pupils?.measure).filter((x): x is string => !!x))];
const pupilsComputable =
  budgets.members.length > 0 && budgets.members.every((m) => m.pupils) && pupilMeasures.length === 1;
const pupilsTotal = pupilsComputable ? budgets.members.reduce((t, m) => t + (m.pupils?.value ?? 0), 0) : null;
const pupilYears = [...new Set(budgets.members.map((m) => m.pupils?.fiscal_year).filter((y): y is number => !!y))].sort();
const pupilLabel = (measure: string) =>
  measure === 'long_term_weighted_adm' ? 'Weighted ADM' : measure === 'equalized_pupils' ? 'Equalized pupils' : 'Pupils';
const fmtPupils = (n: number) => n.toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
const mixedYears = budgets.fiscal_years_present.length > 1;
const state: 'computed' | 'partial' | 'recruitment' = computable
  ? 'computed'
  : budgets.resolved_count === 0
    ? 'recruitment'
    : 'partial';
---

<Base title={`${title} — Vermont School Budgets`}>
  <p><a href={`${base}/groupings/`}>← All merger study groups</a></p>
  <h1>{title}</h1>

  {dissolved ? (
    <>
      <p class="lede">
        {doc.act?.name ?? 'Act 170'} put these districts together as group {grouping.number}. On
        {' '}{longDate(moved?.as_of)} the {moved?.by} split this group up. After some districts asked
        to leave, too few students were left to meet the law's 2,000-student floor, so every district
        went to another group.
      </p>
      <h2>Where each district went</h2>
      <ul>
        {wentTo.map((w) => (
          <li>
            <strong>{w.name}</strong>{' '}
            {w.to ? (
              <>is now in <a href={`${base}/groupings/${w.to.number}/`}>{w.to.name}</a>.</>
            ) : (
              <>is not on the new list.</>
            )}
          </li>
        ))}
      </ul>
    </>
  ) : committee ? (
    <>
      <p class="lede">
        The districts in this merger study group, run one by one and added together.
        {committee.region && <span> Region: {committee.region}.</span>}
        {!committee.verified && <span class="tag unverified" style="margin-left:.5rem">list not checked</span>}
      </p>
      <p style="font-size:.9rem;color:var(--text-muted)">
        From the {moved?.by}'s first list, {longDate(moved?.as_of)}. It may still change.
        {' '}<a href={`${base}/groupings/`}>More about the list</a>.
      </p>

      <h2>Who is in this group</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th scope="col">District</th><th scope="col">Students (ADM)</th></tr>
          </thead>
          <tbody>
            {rosterDistricts.map((l) => (
              <tr>
                <th scope="row">{l.name_as_written}</th>
                <td>{l.adm_as_published != null ? fmt(l.adm_as_published) : '—'}</td>
              </tr>
            ))}
            {committee.adm_total_as_published != null && (
              <tr>
                <th scope="row">Total, as printed</th>
                <td>{fmt(committee.adm_total_as_published)}</td>
              </tr>
            )}
          </tbody>
        </table>
      </div>
      {admMismatch && admSum !== null && (
        <p>
          The list prints this group's total as {fmt(committee.adm_total_as_published!)}. But its
          districts add up to {fmt(admSum)}. We show both numbers just as they were printed.
        </p>
      )}
      {techCenters.length > 0 && (
        <p>
          Also in this group: {techCenters.map((t) => t.name_as_written).join(', ')}. A tech center
          is not a school district, so it has no student count and is not in the totals.
        </p>
      )}
      <p style="font-size:.9rem;color:var(--text-muted)">
        "Students" is the state's count of students who live in the district, averaged over two years.
      </p>

      {(movedIn.length > 0 || movedOut.length > 0 || unlistedHere.length > 0) && (
        <>
          <h2>What changed from the law</h2>
          <ul>
            {movedIn.map((m) => (
              <li>
                <strong>{m.name}</strong> joined from{' '}
                <a href={`${base}/groupings/${m.from_grouping}/`}>group {m.from_grouping}</a>.
              </li>
            ))}
            {movedOut.map((m) => (
              <li>
                <strong>{m.name}</strong> left for{' '}
                <a href={`${base}/groupings/${m.to_grouping}/`}>group {m.to_grouping}</a>.
              </li>
            ))}
            {unlistedHere.map((u) => (
              <li>
                The law named <strong>{u.name}</strong> here. The new list does not.
                {u.slug.startsWith('su/') && <span> It names the districts in it instead.</span>}
              </li>
            ))}
          </ul>
        </>
      )}
      {movedIn.length === 0 && movedOut.length === 0 && unlistedHere.length === 0 && (
        <p>This group has the same districts the law gave it.</p>
      )}

      <h2>Budgets</h2>
    </>
  ) : (
    <p class="lede">
      The districts {doc.act?.name ?? 'Act 170'} groups together, run individually and combined.
      A grouping is a what-if the Legislature already named — this page runs it.
      {!grouping.verified && <span class="tag unverified" style="margin-left:.5rem">membership not checked</span>}
    </p>
  )}

  {!dissolved && state === 'computed' && result && (
    <>
      <h2>Run individually</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th scope="col">District</th><th scope="col">Fiscal year</th><th scope="col">Status</th><th scope="col">Education spending</th><th scope="col">{pupilMeasures.length === 1 ? pupilLabel(pupilMeasures[0]!) : 'Pupils'}</th></tr>
          </thead>
          <tbody>
            {budgets.members.map((m) => (
              <tr>
                <th scope="row">{m.name_as_written ?? m.slug}</th>
                <td>{m.fiscal_year ? `FY${m.fiscal_year}` : '—'}</td>
                <td>{m.spending_basis === 'aoe_edspend' ? 'AOE stated spending' : (m.status ?? '—')}{m.resolution === 'via_su' && m.spending_basis !== 'aoe_edspend' && <span class="tag" style="margin-left:.4rem">via SU</span>}{m.status === 'actual' && <span class="tag" style="margin-left:.4rem">year-end actuals, not an adopted budget</span>}</td>
                <td>{m.budget && m.budget.education_spending !== null ? formatValue(m.budget.education_spending, 'usd') : 'not published'}</td>
                <td>{m.pupils ? <>{fmtPupils(m.pupils.value)}{m.pupils.fiscal_year !== m.fiscal_year && <span class="tag" style="margin-left:.4rem">FY{m.pupils.fiscal_year}</span>}</> : 'not held'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {budgets.members.some((m) => m.spending_basis === 'aoe_edspend') && (
        <div class="notice">
          <strong>
            {budgets.members.every((m) => m.spending_basis === 'aoe_edspend')
              ? 'These figures are AOE\'s stated education spending, not adopted budgets'
              : `${budgets.members.filter((m) => m.spending_basis === 'aoe_edspend').length} of ${budgets.member_count} members use AOE's stated education spending`}
          </strong>
          <details class="notice-more">
            <summary>show more information</summary>
            <p>
              We hold no budget document with a usable total for these districts, so the figure is the
              education spending the Agency of Education reports for each one (Data Request #853), from
              the latest year it lists. It is a state-reported figure, not what a district's voters
              approved, and it can differ from one.
            </p>
          </details>
        </div>
      )}

      <h2>Combined</h2>
      <dl class="facts">
        <dt>{pupilMeasures.length === 1 ? `Combined ${pupilLabel(pupilMeasures[0]!)}` : 'Combined pupils'}</dt>
        <dd>
          {pupilsTotal !== null
            ? fmtPupils(pupilsTotal)
            : pupilMeasures.length > 1
              ? 'not stated: members are counted on different measures'
              : 'not stated: some members have no AOE pupil count'}
        </dd>
        <dt>{result.currentTotal.label}</dt>
        <dd>{formatValue(result.currentTotal.value, 'usd')}</dd>
        <dt>{result.scenarioTotal.label}</dt>
        <dd>{formatValue(result.scenarioTotal.value, 'usd')}</dd>
        <dt>{result.delta.label}</dt>
        <dd>{formatValue(result.delta.value, 'usd')}</dd>
      </dl>
      <p style="color:var(--text-muted)">
        At the default consolidation factor of 1.0 the change is {formatValue(result.delta.value, 'usd')} by
        design: the tool assumes no consolidation you did not choose. Adjust the factor in the
        <a href={`${base}/model/`}>what-if tool</a> to see movement in either direction.
      </p>

      {pupilMeasures.includes('long_term_weighted_adm') && (
        <p style="color:var(--text-muted)">
          Weighted ADM is the Agency of Education's long-term weighted average daily membership: the
          pupil count AOE divides education spending by. Weights count some students (for example
          those in poverty or learning English) as more than one, so it is larger than a head count.
          {pupilYears.length > 1 && ` Counts are from ${pupilYears.map((y) => `FY${y}`).join(', ')}.`}
        </p>
      )}

      {mixedYears && (
        <div class="notice">
          <strong>Members' budgets are from different years</strong>
          <details class="notice-more">
            <summary>show more information</summary>
            <p>The combined figure mixes fiscal years {budgets.fiscal_years_present.map((y) => `FY${y}`).join(', ')}. Compare years before quoting it.</p>
          </details>
        </div>
      )}

      <h2>Assumptions</h2>
      <dl class="facts">
        {result.assumptions.map((a) => (
          <>
            <dt>{a.label}</dt>
            <dd>{a.value} — {a.rationale}</dd>
          </>
        ))}
      </dl>

      <h2>Before you quote this</h2>
      <ul>{result.caveats.map((c) => <li>{c}</li>)}</ul>
    </>
  )}

  {!dissolved && state === 'partial' && (
    <>
      <h2>Run individually (partial)</h2>
      <div class="scroll-x">
        <table>
          <thead>
            <tr><th scope="col">District</th><th scope="col">Fiscal year</th><th scope="col">Education spending</th><th scope="col">Pupils</th></tr>
          </thead>
          <tbody>
            {budgets.members.map((m) => (
              <tr>
                <th scope="row">{m.name_as_written ?? m.slug}</th>
                <td>{m.fiscal_year ? `FY${m.fiscal_year}` : '—'}</td>
                <td>{m.budget && m.budget.education_spending !== null ? formatValue(m.budget.education_spending, 'usd') : 'no budget held'}{m.status === 'actual' && <span class="tag" style="margin-left:.4rem">year-end actuals, not an adopted budget</span>}</td>
                <td>{m.pupils ? fmtPupils(m.pupils.value) : 'not held'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="notice blocking">
        <strong>Combined total not computed: {gaps.length} of {budgets.member_count} member budgets are missing</strong>
        <details class="notice-more">
          <summary>show more information</summary>
          <p>A combined figure is only shown when every member has a published total, so one missing budget does not silently shrink the group. Missing or unmatched:</p>
          <ul>
            {gaps.map((m) => <li>{m.name_as_written ?? m.slug} — {m.resolution === 'ambiguous' ? 'budget held only at the supervisory-union level, which serves more than one district' : 'no budget held'}</li>)}
          </ul>
          <p>Have one of these budgets? <a href={`${base}/su/`}>Find the supervisory union</a> and send the document in through its issue form — a bot opens the pull request.</p>
        </details>
      </div>
    </>
  )}

  {!dissolved && state === 'recruitment' && (
    <div class="notice blocking">
      <strong>No member budgets held for this group yet</strong>
      <details class="notice-more">
        <summary>show more information</summary>
        <p>None of the {budgets.member_count} districts in this group has a budget document collected, so the merger comparison cannot be run. This is a gap in coverage, not a statement that these districts published nothing.</p>
        <h3>Members</h3>
        <ul>{budgets.members.map((m) => <li>{m.name_as_written ?? m.slug} <code>{m.slug}</code></li>)}</ul>
        <p>Have one of these budgets? <a href={`${base}/su/`}>Find the supervisory union</a> and send it in through its issue form.</p>
      </details>
    </div>
  )}

  <h2>Where this comes from</h2>
  <dl class="facts">
    <dt>Law</dt>
    <dd>{doc.act?.citation?.statute ?? '—'}</dd>
    {listSource && committees.length > 0 && (
      <>
        <dt>Group list</dt>
        <dd><a href={listSource.url}>{listSource.publisher}, "{listSource.title}"</a>, {longDate(listSource.published_date)}</dd>
      </>
    )}
  </dl>
</Base>
