---
/**
 * The address this page had before the fiscal year was part of it. Kept so
 * old links and bookmarks still arrive: it sends the visitor on to the default
 * year's page.
 */
import YearRedirect from '../../../components/YearRedirect.astro';
import { journeyFor } from '../../../lib/journey-data.ts';
import { DEFAULT_YEAR } from '../../../lib/years.ts';

export function getStaticPaths() {
  return Object.values(journeyFor(DEFAULT_YEAR).districts).map((p) => ({
    params: { slug: p.slug },
    props: { slug: p.slug, name: `Your school district: ${p.name}` },
  }));
}

const { slug, name } = Astro.props;
---

<YearRedirect kind="district" slug={slug} name={name} />
