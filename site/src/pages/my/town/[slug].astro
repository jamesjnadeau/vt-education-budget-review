---
import Base from '../../../layouts/Base.astro';
import registry from '../../../generated/registry.json';
import combiner from '../../../generated/combiner.json';
import subgroups from '../../../generated/adm-subgroups.json';
import groupings from '../../../generated/groupings.json';
import { buildJourney } from '../../../lib/journey.ts';
import { percentileWords, percentText } from '../../../lib/journey-scale.ts';
import JourneyStats from '../../../components/JourneyStats.astro';
import SourceLine from '../../../components/SourceLine.astro';
import ResidualNote from '../../../components/ResidualNote.astro';
import { residualFor } from '../../../lib/rate-residuals.ts';
import { TAX_RATES_FY2026 } from '../../../lib/sources.ts';
import JourneyProgress from '../../../components/JourneyProgress.astro';
import JourneyNext from '../../../components/JourneyNext.astro';
import DotGrid from '../../../components/DotGrid.astro';
import ScaleBar from '../../../components/ScaleBar.astro';

export function getStaticPaths() {
  const journey = buildJourney({
    registry: registry.entities,
    combiner: combiner as never,
    subgroups: subgroups as never,
    groupings: groupings as never,
  });
  return Object.values(journey.towns).map((t) => ({ params: { slug: t.slug }, props: { page: t } }));
}

const { page } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const residual = residualFor(page.districtSlug) ?? residualFor(`town/${page.slug}`);

const ratePct = page.rateScale.kind === 'value' ? page.rateScale.value : null;
const studentsPct = page.studentsScale.kind === 'value' ? page.studentsScale.value : null;
const peoplePct = page.peopleScale.kind === 'value' ? page.peopleScale.value : null;

// DotGrid dots are 0-indexed; mineIndex is the count below (its position).
const mineIndex = ratePct ? ratePct.lower : null;

const shareText = (s: number): string => percentText(s);

function renderShare(
  s: { students: { kind: string; value?: number; reason?: string }; people: { kind: string; value?: number; reason?: string } },
  what: string,
): string {
  const values: string[] = [];
  if (s.students.kind === 'value' && s.students.value != null) {
    values.push(`${shareText(s.students.value)} of the students`);
  }
  if (s.people.kind === 'value' && s.people.value != null) {
    values.push(`${shareText(s.people.value)} of the people`);
  }
  if (values.length > 0) {
    return `This works out to about ${values.join(' and ')} of ${what}.`;
  }
  const reasons = [s.students.reason, s.people.reason].filter(Boolean);
  return `The share of ${what} can't be given right now. ${reasons.join(' ')}`;
}
---

<Base title={`Your town: ${page.name} — Vermont School Budgets`}>
  <JourneyProgress steps={page.steps} current="town" />

  <h1>Your town: {page.name}</h1>

  <JourneyStats
    rate={page.rate}
    students={page.students}
    people={page.people}
    rateLabel="Homestead tax rate (FY2026)"
    studentsLabel="Students counted by the state (school year 2025)"
    peopleLabel="People (2020 Census)"
    county={page.county}
    comparators={page.comparators}
  />
  <SourceLine source={TAX_RATES_FY2026} />
  {residual && <ResidualNote reason={residual} />}

  <h2>How {page.name} fits in</h2>
  <p class="lede">
    In the figures below, the <strong>homestead tax rate</strong> is the school tax rate for the
    home you live in; <strong>students counted by the state</strong> (ADM) are the public school
    students who live here; and a <strong>supervisory union</strong> is a group of nearby school
    districts that run their schools' business together.
  </p>

  {/* --- Rate scale --- */}
  <h3>Your town's tax rate, compared</h3>
  {
    ratePct ? (
      <DotGrid
        total={ratePct.of}
        mineIndex={mineIndex}
        caption={`${percentileWords(ratePct, 'towns')}. Your dot is shown in green.`}
      />
    ) : (
      <p class="blank-reason">{page.rateScale.kind === 'blank' ? page.rateScale.reason : 'The tax rate is not published, so there is nothing to compare.'}</p>
    )
  }

  {/* --- Students scale --- */}
  <h3>Your town's students, compared</h3>
  {
    studentsPct ? (
      <ScaleBar
        fraction={studentsPct.lower > 0 ? Math.min(1, studentsPct.lower / Math.max(1, studentsPct.of)) : 0}
        caption={`${percentileWords(studentsPct, 'towns')}.`}
      />
    ) : (
      <p class="blank-reason">{page.studentsScale.kind === 'blank' ? page.studentsScale.reason : 'The student count is not an exact number, so there is nothing to compare.'}</p>
    )
  }

  {/* --- People scale --- */}
  <h3>Your town's people, compared</h3>
  {
    peoplePct ? (
      <ScaleBar
        fraction={peoplePct.lower > 0 ? Math.min(1, peoplePct.lower / Math.max(1, peoplePct.of)) : 0}
        caption={`${percentileWords(peoplePct, 'towns')}.`}
      />
    ) : (
      <p class="blank-reason">{page.peopleScale.kind === 'blank' ? page.peopleScale.reason : 'The population is not published, so there is nothing to compare.'}</p>
    )
  }

  {/* --- Shares --- */}
  {
    page.shares.district && (
      <div class="journey-share">
        <h3>Your share of the school district</h3>
        {renderShare(page.shares.district, 'your school district')}
      </div>
    )
  }
  {
    page.shares.union && (
      <div class="journey-share">
        <h3>Your share of the supervisory union</h3>
        {renderShare(page.shares.union, 'your supervisory union')}
      </div>
    )
  }
  {
    page.shares.grouping && (
      <div class="journey-share">
        <h3>Your share of your group</h3>
        {renderShare(page.shares.grouping, 'your group')}
      </div>
    )
  }

  {
    page.committeeNumber === null && page.unionSlug !== null && (
      <div class="notice journey-no-group">
        <strong>The Vermont Learning Collaborative has not placed your school district in a group yet.</strong>
        <p>
          Act 170 of 2026 lets the study's facilitators set the groups, and the Collaborative is
          the one running them. This journey stops at your supervisory union until your district
          has a group.
        </p>
      </div>
    )
  }

  {
    page.next && <JourneyNext next={page.next} base={base} />
  }

  <p class="journey-change">
    <a href={`${base}/my/?change=1`}>Not your town? Choose a different one.</a>
  </p>
</Base>
