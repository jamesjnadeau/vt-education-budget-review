---
import Base from '../../../../layouts/Base.astro';
import { journeyFor } from '../../../../lib/journey-data.ts';
import { YEARS, myHref } from '../../../../lib/years.ts';
import { studentsLabel, yearNotes } from '../../../../lib/year-notes.ts';
import JourneyTop from '../../../../components/JourneyTop.astro';
import YearNotes from '../../../../components/YearNotes.astro';
import { titleCase } from '../../../../lib/display.ts';
import { rateRangeText } from '../../../../lib/rate-format.ts';
import { groupRateReason, showsGroupRateCard, EXPLAIN } from '../../../../lib/rate-copy.ts';
import ResidualNote from '../../../../components/ResidualNote.astro';
import { residualFor, RESIDUAL_YEAR } from '../../../../lib/rate-residuals.ts';
import JourneyStats from '../../../../components/JourneyStats.astro';
import JourneyNext from '../../../../components/JourneyNext.astro';

export function getStaticPaths() {
  // Which student count each year uses, so a page can say when its neighbour differs.
  const kinds = new Map(YEARS.map((y) => [y, journeyFor(y).studentsSource?.kind ?? null] as const));
  return YEARS.flatMap((year) => {
    const journey = journeyFor(year);
    const notes = yearNotes(journey, kinds);
    return Object.values(journey.districts).map((p) => ({
      params: { year: String(year), slug: p.slug },
      props: { page: p, year, notes, studentsSource: journey.studentsSource },
    }));
  });
}

const { page, year, notes, studentsSource } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const residual = year === RESIDUAL_YEAR ? residualFor(`ud/${page.slug}`) : null;
---

<Base title={`Your school district: ${page.name}, fiscal year ${year} — Vermont School Budgets`}>
  <JourneyTop steps={page.steps} current="district" year={year} kind="district" slug={page.slug} />

  <h1>Your school district: {page.name}</h1>
  <p class="lede">A few towns share this district's school budget. Yours is one of them.</p>

  {
    page.rateRange.kind === 'value' ? (
      <dl class="facts">
        <dt>Homestead tax rate (FY{year})</dt>
        <dd>
          {rateRangeText(page.rateRange.value.low, page.rateRange.value.high)}{' '}
          Across{' '}
          {page.rateRange.value.covers} of {page.rateRange.value.of} towns. School tax only,{' '}
          <a href={`${base}${EXPLAIN.credit}`}>before the property tax credit</a>.
        </dd>
      </dl>
    ) : (
      <div class="notice">
        <p class="blank-reason">{page.rateRange.reason}</p>
      </div>
    )
  }

  <JourneyStats
    rate={{ kind: 'blank' as const, why: 'not_computable', reason: groupRateReason('district') }}
    showRate={showsGroupRateCard(page.rateRange)}
    students={page.students}
    people={page.people}
    rateLabel={`Homestead tax rate (FY${year})`}
    studentsLabel={studentsLabel(studentsSource, true)}
    peopleLabel="People, combined (2020 Census)"
  />
  <p class="muted">
    Read more about the <a href={`${base}${EXPLAIN.cla}`}>common level of appraisal</a>.
  </p>

  {residual && <ResidualNote reason={residual} />}
  <YearNotes notes={notes} />

  <h2>Your town is one of these</h2>
  <p>All of these towns pay for this district together.</p>
  <ul class="grid">
    {page.members.map((m) => (
      <li class="card">
        <a href={`${base}${myHref(year, 'town', m.town)}`}>{titleCase(m.name)}</a>
      </li>
    ))}
  </ul>

  {
    page.next && <JourneyNext next={page.next} base={base} />
  }

  <p class="journey-change">
    <a href={`${base}/my/?change=1`}>Not your town? Choose a different one.</a>
  </p>
</Base>
