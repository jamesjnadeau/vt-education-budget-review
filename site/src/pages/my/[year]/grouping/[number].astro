---
import Base from '../../../../layouts/Base.astro';
import { journeyFor } from '../../../../lib/journey-data.ts';
import { YEARS, myHref } from '../../../../lib/years.ts';
import { studentsLabel, yearNotes } from '../../../../lib/year-notes.ts';
import JourneyTop from '../../../../components/JourneyTop.astro';
import YearNotes from '../../../../components/YearNotes.astro';
import groupingsDoc from '../../../../generated/groupings.json';
import { longDate } from '../../../../lib/groupings.ts';
import { titleCase } from '../../../../lib/display.ts';
import { rateRangeText } from '../../../../lib/rate-format.ts';
import { groupRateReason, EXPLAIN } from '../../../../lib/rate-copy.ts';
import JourneyStats from '../../../../components/JourneyStats.astro';

const reassignment = (groupingsDoc as { reassignment?: { by?: string | null; roster_as_of?: string | null; sources?: { retrieved_by?: string | null; retrieved_date?: string | null }[] } }).reassignment;
// The date the list was brought in, from the source record, not a hardcoded value.
const source = reassignment?.sources?.find((s) => s.retrieved_by?.includes('James Nadeau')) ?? reassignment?.sources?.[0];
const feltDate = source?.retrieved_date ?? reassignment?.roster_as_of ?? null;

export function getStaticPaths() {
  // Which student count each year uses, so a page can say when its neighbour differs.
  const kinds = new Map(YEARS.map((y) => [y, journeyFor(y).studentsSource?.kind ?? null] as const));
  return YEARS.flatMap((year) => {
    const journey = journeyFor(year);
    const notes = yearNotes(journey, kinds);
    return Object.values(journey.groupings).map((p) => ({
      params: { year: String(year), number: p.slug },
      props: { page: p, year, notes, studentsSource: journey.studentsSource },
    }));
  });
}

const { page, year, notes, studentsSource } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const by = reassignment?.by ?? 'the facilitators';
const preliminaryNote =
  `The group list on this page is the one ${by} put together (their list as of ` +
  (feltDate ? longDate(feltDate) : 'an unrecorded date') +
  `), brought in on ` +
  (source?.retrieved_date ? longDate(source.retrieved_date) : 'an unrecorded date') +
  `. It has not been checked line by line by a person yet, so treat it as preliminary.`;
---

<Base title={`Your pathway group ${page.slug}, fiscal year ${year} — Vermont School Budgets`}>
  <JourneyTop steps={page.steps} current="grouping" year={year} kind="grouping" slug={page.slug} />

  <h1>Your group: {page.name}</h1>
  <p class="lede">
    Act 170 divided Vermont's school districts into groups to plan how they'd work together.
    The people in charge of the study later moved some districts into committees that meet now.
    Your town's district sits in one of those committees.
  </p>

  {
    page.rateRange.kind === 'value' ? (
      <dl class="facts">
        <dt>Homestead tax rate (FY{year})</dt>
        <dd>
          {rateRangeText(page.rateRange.value.low, page.rateRange.value.high)}{' '}
          Across{' '}
          {page.rateRange.value.covers} of {page.rateRange.value.of} towns. School tax only,{' '}
          <a href={`${base}${EXPLAIN.credit}`}>before the property tax credit</a>.
        </dd>
      </dl>
    ) : (
      <div class="notice">
        <p class="blank-reason">{page.rateRange.reason}</p>
      </div>
    )
  }

  <JourneyStats
    rate={{ kind: 'blank' as const, why: 'not_computable', reason: groupRateReason('grouping') }}
    students={page.students}
    people={page.people}
    rateLabel={`Homestead tax rate (FY${year})`}
    studentsLabel={studentsLabel(studentsSource, true)}
    peopleLabel="People, combined (2020 Census)"
  />
  <YearNotes notes={notes} />

  <h2>Districts in this group</h2>
  <ul class="grid">
    {page.members.map((m) => (
      <li class="card">
        <a href={`${base}${myHref(year, 'town', m.town)}`}>{titleCase(m.name)}</a>
      </li>
    ))}
  </ul>

  {
    page.actGroup && (
      <div class="notice">
        <p>
          Act 170 first placed these districts in a group numbered {page.actGroup.number}
          {page.actGroup.moved ? '; the people in charge of the study have since moved some of them.' : ', and that has not changed.'}
        </p>
      </div>
    )
  }

  <details class="data-notes">
    <summary>About this group list</summary>
    <p>{preliminaryNote}</p>
  </details>

  <p class="journey-change">
    <a href={`${base}/my/?change=1`}>Not your town? Choose a different one.</a>
  </p>
</Base>
