---
import Base from '../../layouts/Base.astro';
import registry from '../../generated/registry.json';
import coverage from '../../generated/coverage.json';
import adm from '../../generated/adm.json';
import parameters from '../../generated/parameters.json';
import homesteadComparison from '../../generated/homestead-comparison.json';
import subgroups from '../../generated/adm-subgroups.json';
import { slugTail, titleCase } from '../../lib/display';
import { ROWS, count, sumCells, type Sum, type TownYear, type Year } from '../../lib/residents';

interface AdmGapEntry {
  input: string;
  statute: string;
  supplied: boolean;
  note: string;
}

interface Entity {
  slug: string;
  name: string;
  type: string;
  aoe_org_id?: string;
  effective_from: string | null;
  effective_from_basis: string;
  effective_to: string | null;
  effective_to_basis: string;
  supervisory_union: string | null;
  operated_by: string | null;
  member_towns: string[];
  grades: string[];
  website: string | null;
  reporting_only?: boolean;
}

export function getStaticPaths() {
  const entities = registry.entities as Entity[];
  return entities
    .filter((e) => e.type === 'su')
    .map((su) => ({ params: { slug: su.slug.split('/')[1] }, props: { su } }));
}

const { su } = Astro.props as { su: Entity };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entities = registry.entities as Entity[];

const districts = entities.filter((e) => e.type === 'ud' && e.supervisory_union === su.slug);
const schools = entities.filter((e) => e.type === 'school' && e.supervisory_union === su.slug);
const towns = entities.filter((e) => e.type === 'town' && e.supervisory_union === su.slug);

const cells = (coverage.cells as Array<{
  entity: string;
  fiscalYear: number;
  state: string;
  warehouseFile: string | null;
  intakeFiles: string[];
  intakeUrl: string | null;
  normalizeUrl: string | null;
  flagUrl: string | null;
}>).filter((c) => c.entity === su.slug);

const byDistrict = new Map<string, Entity[]>();
for (const town of towns) {
  if (!town.operated_by) continue;
  const list = byDistrict.get(town.operated_by) ?? [];
  list.push(town);
  byDistrict.set(town.operated_by, list);
}

// --- Students who live here ------------------------------------------------
// The town-of-residence counts, added up across this SU's member towns. The
// generated file stays town grain; the sum is made here, on every build, and
// says only what the withheld town cells allow (see lib/residents.ts).
interface Resident {
  town: Entity;
  byYear: Record<string, TownYear>;
}
const years = subgroups.years as Year[];
const residentTowns: Resident[] = towns
  .filter((t) => !t.reporting_only)
  .map((t) => ({
    town: t,
    byYear: ((subgroups.towns as Record<string, Record<string, TownYear>>)[t.slug] ?? {}) as Record<
      string,
      TownYear
    >,
  }));
const hasResidents = residentTowns.some((r) => years.some((y) => r.byYear[y.school_year] !== undefined));

/** The delivered rows for a year, one per member town that had resident students. */
function deliveredFor(y: Year) {
  return residentTowns
    .map((r) => r.byYear[y.school_year])
    .filter((t): t is Extract<TownYear, { row: 'published' | 'below_reporting_floor' }> =>
      t !== undefined && t.row !== 'not_applicable',
    );
}
/** Years in which at least one member town had a delivered row. */
const shownYears = years.filter((y) => deliveredFor(y).length > 0);
/** Years every member town shows as having no resident students. */
const emptyYears = years.filter(
  (y) => deliveredFor(y).length === 0 && residentTowns.some((r) => r.byYear[y.school_year] !== undefined),
);

const sums: Record<string, Record<string, Sum>> = {};
for (const y of years) {
  const delivered = deliveredFor(y);
  sums[y.school_year] = {};
  for (const r of ROWS) {
    sums[y.school_year][r.label] = sumCells(delivered.map((t) => r.pick(t)));
  }
}
const anyRange = years.some((y) => ROWS.some((r) => sums[y.school_year][r.label].kind === 'range'));
const anyUnbounded = years.some((y) =>
  ROWS.some((r) => {
    const s = sums[y.school_year][r.label];
    return s.kind === 'range' && s.high === null;
  }),
);
/** Member towns with at least one hidden cell in any shown year, for the reader to follow up. */
const hiddenTowns = residentTowns.filter((r) =>
  shownYears.some((y) => {
    const t = r.byYear[y.school_year];
    if (t === undefined || t.row === 'not_applicable') return false;
    return ROWS.some((row) => {
      const c = row.pick(t);
      return 'status' in c && c.status === 'suppressed';
    });
  }),
);
const preliminaryYears = shownYears.filter((y) => y.preliminary);
const unusableYears = shownYears.filter((y) => y.not_published.length > 0);

function sumText(s: Sum): string {
  if (s.kind === 'exact') return count(s.value);
  if (s.kind !== 'range') return '—';
  if (s.high === null) return `at least ${count(s.low)}`;
  return `${count(s.low)} to ${count(s.high)}`;
}

// --- What the baseline figures are waiting on ---------------------------------
// The engine refuses to publish weighted membership, per-pupil spending or
// homestead rates while any input is missing. The three families below are those
// inputs, drawn from the same generated data the engine reads.

// 1. Membership inputs. adm.json's gaps block enumerates every § 4010 input and
//    whether it has been imported; missingMembershipInputs are the ones absent
//    for every district, and blockReasons the structural notes behind them.
const admGaps = adm.gaps as {
  entries: AdmGapEntry[];
  weighted_membership_blocked_because: string[];
};
const missingMembershipInputs = admGaps.entries.filter((e) => !e.supplied);
const blockReasons = admGaps.weighted_membership_blocked_because;

// 2. Spending. The numerator of per-pupil spending is education spending, which
//    comes from this SU's own budget documents.
const normalizedYears = cells.filter((c) => c.state === 'normalized').length;

// 3. Statutory numbers. Homestead rates rest on yields and weights whose check
//    status lives in the parameter files; count the ones still unchecked.
const paramSets = parameters as Array<{ unverified_count: number; parameters: unknown[] }>;
const unverifiedParams = paramSets.reduce((n, s) => n + s.unverified_count, 0);
const totalParams = paramSets.reduce((n, s) => n + s.parameters.length, 0);

// 4. Homestead rate comparison. Published rates are available now; calculated
//    rates are blocked until the inputs above are, which the table shows
//    directly per town/year rather than restating the blockers in prose.
const homesteadYears = (homesteadComparison.sus as Record<string, Record<string, Array<{
  town: string; published: number | null; calculated: number | null; blocker: string | null; difference: number | null;
}>>>)[su.slug] ?? {};
const homesteadRows = Object.entries(homesteadYears)
  .flatMap(([year, cells]) => cells.map((c) => ({ year, ...c })))
  .sort((a, b) => Number(b.year) - Number(a.year) || a.town.localeCompare(b.town));
---

<Base title={`${titleCase(su.name)} — Vermont School Budgets`}>
  <h1>{titleCase(su.name)}</h1>

  <dl class="facts">
    <dt>Registry ID</dt>
    <dd><code>{su.slug}</code></dd>
    <dt>AOE organization ID</dt>
    <dd><code>{su.aoe_org_id ?? '—'}</code></dd>
    <dt>Status</dt>
    <dd>
      {su.effective_to ? `closed ${su.effective_to} (${su.effective_to_basis})` : 'active'}
    </dd>
    <dt>First recorded</dt>
    <dd>
      {su.effective_from ?? '—'}
      {
        su.effective_from_basis === 'first_observed' && (
          <span class="tag missing-input" style="margin-left:.5rem">
            date first observed, not a founding date
          </span>
        )
      }
    </dd>
    {su.website && (
      <>
        <dt>Website</dt>
        <dd><a href={su.website} rel="noopener">{su.website}</a></dd>
      </>
    )}
  </dl>

  {
    hasResidents && (
      <>
        <h2>Students who live here</h2>
        <p>
          Each year the state counts the public school students who live in each town. This table
          adds up those counts for the {residentTowns.length} towns in {titleCase(su.name)}. The
          count follows the student, not the school. So it includes students who go to school
          somewhere else, and it leaves out students who come here from another supervisory union.
          {shownYears.length > 0 &&
            ' A student who was enrolled for part of the year counts as part of one, which is why some numbers have decimals.'}
          {' '}Each town's own page shows its share.
        </p>
        {shownYears.length > 0 && (
          <div class="scroll-x">
            <table class="residents">
              <thead>
                <tr>
                  <th scope="col">Students</th>
                  {years.map((y) => (
                    <th scope="col" class="numeric">
                      {y.count_year}
                      {y.preliminary && <span class="muted"> (may change)</span>}
                    </th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {ROWS.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    {years.map((y) => {
                      const s = sums[y.school_year][r.label];
                      if (s.kind === 'not_usable') {
                        return (
                          <td class="numeric">
                            <span class="tag not-computable">not usable</span>
                          </td>
                        );
                      }
                      if (s.kind === 'range') {
                        return (
                          <td class="numeric">
                            {sumText(s)}
                            <div class="muted">
                              {s.hidden} town{s.hidden === 1 ? '' : 's'} hidden
                            </div>
                          </td>
                        );
                      }
                      return <td class="numeric">{sumText(s)}</td>;
                    })}
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
        {anyRange && (
          <p>
            Some cells show a <strong>range</strong> instead of one number. That is because the
            state hid the count for one or more towns, to protect student privacy. The state hides
            any count under 11. It also hides some bigger counts, so that nobody can work out a
            hidden one by subtracting. We add the hidden towns' numbers to the sum as the smallest
            and largest values the rules allow, so the real number is somewhere in the range.
            {anyUnbounded &&
              ' Where the rules do not say how big a hidden number could be, we can only say "at least".'}
          </p>
        )}
        {hiddenTowns.length > 0 && (
          <p>
            Towns with hidden numbers:{' '}
            {hiddenTowns.map((r, i) => (
              <>{i > 0 && ', '}<a href={`${base}/town/${slugTail(r.town.slug)}/`}>{titleCase(r.town.name)}</a></>
            ))}.
          </p>
        )}
        {preliminaryYears.map((y) => (
          <p>
            The {y.count_year} numbers <strong>may change</strong>. We asked the state whether
            they are final and had not heard back when this page was built.
          </p>
        ))}
        {unusableYears.map((y) => (
          <p>
            For {y.count_year}, the state's English learner and lunch counts were{' '}
            <strong>not usable</strong>, so we do not show them. The state did not collect the
            English learner flag that year, and it has said its lunch flag was set for nearly every
            student by mistake.
          </p>
        ))}
        {emptyYears.length > 0 && (
          <p>
            No students were counted as living in any of these towns in{' '}
            {emptyYears.map((y) => y.count_year).join(', ')}.
          </p>
        )}
      </>
    )
  }

  <h2>Budget documents</h2>
  {
    cells.every((c) => c.state === 'missing') ? (
      <div class="notice">
        <strong>No budget documents held for this supervisory union</strong>
        <p>
          Nothing has been collected yet for any of the {cells.length} fiscal years this site
          tracks. This is a gap in coverage, not a statement that the SU published nothing.
        </p>
        {cells[0]?.intakeUrl && (
          <p>
            If you have one:{' '}
            <a href={cells[0].intakeUrl}>send it in through the issue form</a> — drag the file in
            and say where it came from, and a bot opens the pull request. Or{' '}
            <a href={cells[0].flagUrl ?? '#'}>open an issue</a> recording what you checked.
          </p>
        )}
      </div>
    ) : (
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th scope="col">Fiscal year</th>
              <th scope="col">State</th>
              <th scope="col">Files</th>
            </tr>
          </thead>
          <tbody>
            {cells.map((c) => (
              <tr>
                <th scope="row">FY{c.fiscalYear}</th>
                <td>
                  {c.state === 'intake_only' && c.normalizeUrl ? (
                    <a href={c.normalizeUrl}>normalize</a>
                  ) : (
                    c.state.replace('_', ' ')
                  )}
                </td>
                <td>
                  {c.warehouseFile ? <code>{c.warehouseFile}</code> : c.intakeFiles.join(', ') || '—'}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Baseline figures</h2>
  <p>
    Three figures anchor everything else: weighted long-term membership, spending per weighted
    pupil, and each member town's homestead rate. None can be computed yet. The engine returns
    nothing rather than a plausible number — so here is exactly what each one is still waiting on.
  </p>

  <div class="notice blocking">
    <strong>Weighted long-term membership — missing inputs</strong>
    <p>Even where student counts are published, the count as it stands cannot be reduced to the figure the statute asks for:</p>
    <ul>
      {blockReasons.map((reason) => <li>{reason}</li>)}
    </ul>
    <p>
      Concretely, these <span style="white-space:nowrap">16 V.S.A. § 4010</span> inputs are not yet
      held for any district:
    </p>
    <ul>
      {missingMembershipInputs.map((e) => (
        <li>
          <code>{e.input}</code>{' '}
          <span style="color:var(--text-muted);font-size:.9rem">— {e.statute}</span>
        </li>
      ))}
    </ul>
  </div>

  <div class="notice blocking">
    <strong>Spending per weighted pupil — needs education spending</strong>
    <p>
      This divides a district's education spending by the weighted membership above, so it is
      blocked by that figure and by the spending itself. Education spending comes from the budget
      documents listed earlier on this page:{' '}
      {normalizedYears === 0
        ? `none of the ${cells.length} fiscal years tracked here are normalized yet`
        : `${normalizedYears} of ${cells.length} fiscal years are normalized`}.
    </p>
  </div>

  <div class="notice blocking">
    <strong>Member-town homestead rates — need the two figures above</strong>
    <p>
      A homestead rate rests on both figures above and on the statutory yields and weights that
      convert spending into a rate.
      {unverifiedParams > 0 && (
        <>
          {' '}Of the legal numbers those calculations draw on, {unverifiedParams} of {totalParams}
          {' '}are still unchecked against current statute — listed year by year, with sources, on
          the <a href={`${base}/methodology/`}>methodology page</a>.
        </>
      )}
    </p>
  </div>

  <p>
    You can see the shape of the whole calculation — every step and every citation — in the{' '}
    <a href={`${base}/model/?su=${slugTail(su.slug)}`}>modeling tool</a>.
  </p>

  {homesteadRows.length > 0 && (
    <>
      <h2>Homestead rate: calculated vs published</h2>
      <p>
        Each member town's homestead rate as printed in the budget, beside the rate the statutory
        formula produces from this SU's education spending and resolved membership. The calculated
        column is blank while any statutory parameter it needs is still unverified — it shows what
        it is waiting on, and fills in once those are checked.
      </p>
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th scope="col">Town</th>
              <th scope="col">Year</th>
              <th scope="col">Published</th>
              <th scope="col">Calculated (billed)</th>
              <th scope="col">Difference</th>
            </tr>
          </thead>
          <tbody>
            {homesteadRows.map((r) => (
              <tr>
                <th scope="row">{slugTail(r.town)}</th>
                <td>FY{r.year}</td>
                <td>{r.published === null ? '—' : r.published.toFixed(4)}</td>
                <td>
                  {r.calculated !== null ? (
                    r.calculated.toFixed(4)
                  ) : (
                    <span class="tag unverified">awaiting {r.blocker ?? 'inputs'}</span>
                  )}
                </td>
                <td>{r.difference === null ? '—' : r.difference.toFixed(4)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  <h2>Member districts ({districts.length})</h2>
  {
    districts.length === 0 ? (
      <p>No unified districts recorded under this supervisory union.</p>
    ) : (
      <ul class="grid">
        {districts.map((d) => (
          <li class="card">
            <strong>{titleCase(d.name)}</strong>
            <p style="margin:.4rem 0 0;font-size:.9rem;color:var(--text-muted)">
              <code>{d.slug}</code>
              <br />
              {(byDistrict.get(d.slug) ?? []).length} member town(s)
              {d.effective_to && ` · closed ${d.effective_to}`}
            </p>
          </li>
        ))}
      </ul>
    )
  }

  <h2>Schools ({schools.length})</h2>
  {
    schools.length === 0 ? (
      <p>No schools recorded under this supervisory union.</p>
    ) : (
      <div class="scroll-x">
        <table>
          <thead>
            <tr>
              <th scope="col">School</th>
              <th scope="col">Grades</th>
              <th scope="col">Operated by</th>
            </tr>
          </thead>
          <tbody>
            {schools.map((s) => (
              <tr>
                <td>{titleCase(s.name)}</td>
                <td>{s.grades.length > 0 ? s.grades.join(', ') : '—'}</td>
                <td><code>{s.operated_by ?? '—'}</code></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }

  <h2>Member towns ({towns.length})</h2>
  {
    towns.length === 0 ? (
      <p>No towns recorded under this supervisory union.</p>
    ) : (
      <ul class="grid">
        {towns.map((t) => (
          <li class="card">
            <a href={`${base}/town/${slugTail(t.slug)}/`}>{titleCase(t.name)}</a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
