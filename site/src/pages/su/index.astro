---
import Base from '../../layouts/Base.astro';
import registry from '../../generated/registry.json';
import coverage from '../../generated/coverage.json';
import { slugTail, titleCase } from '../../lib/display';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

interface Entity {
  slug: string;
  name: string;
  type: string;
  effective_to: string | null;
  supervisory_union: string | null;
}

const entities = registry.entities as Entity[];
const sus = entities
  .filter((e) => e.type === 'su')
  .sort((a, b) => Number(Boolean(a.effective_to)) - Number(Boolean(b.effective_to)) || a.name.localeCompare(b.name));

const districtCount = (slug: string) =>
  entities.filter((e) => e.type === 'ud' && e.supervisory_union === slug).length;
const townCount = (slug: string) =>
  entities.filter((e) => e.type === 'town' && e.supervisory_union === slug).length;

const held = new Map<string, number>();
for (const cell of coverage.cells as Array<{ entity: string; state: string }>) {
  if (cell.state === 'normalized') held.set(cell.entity, (held.get(cell.entity) ?? 0) + 1);
}
---

<Base title="Supervisory unions — Vermont School Budgets">
  <h1>Supervisory unions and supervisory districts</h1>
  <p class="lede">
    A supervisory union is a group of Vermont school districts that share some staff and services.
    {sus.filter((s) => !s.effective_to).length} are active and {sus.filter((s) => s.effective_to).length} are closed.
    We keep the closed ones instead of deleting them, so their history stays here — that is what
    lets you compare things before and after a merger.
  </p>

  <div class="scroll-x">
    <table>
      <thead>
        <tr>
          <th scope="col">Supervisory union</th>
          <th scope="col" class="numeric">Districts</th>
          <th scope="col" class="numeric">Towns</th>
          <th scope="col" class="numeric">Budgets held</th>
          <th scope="col">Status</th>
        </tr>
      </thead>
      <tbody>
        {
          sus.map((su) => (
            <tr>
              <td>
                <a href={`${base}/su/${slugTail(su.slug)}/`}>{titleCase(su.name)}</a>
              </td>
              <td class="numeric">{districtCount(su.slug)}</td>
              <td class="numeric">{townCount(su.slug)}</td>
              <td class="numeric">{held.get(su.slug) ?? 0}</td>
              <td>
                {su.effective_to ? (
                  <span class="tag">closed {su.effective_to}</span>
                ) : (
                  <span class="tag ok">active</span>
                )}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
</Base>
