---
import Base from '../../layouts/Base.astro';
import registry from '../../generated/registry.json';
import subgroups from '../../generated/adm-subgroups.json';
import { slugTail, titleCase } from '../../lib/display';
import { ROWS, bound, count, type TownYear, type Year } from '../../lib/residents';

interface Entity {
  slug: string;
  name: string;
  type: string;
  aoe_org_id?: string;
  supervisory_union: string | null;
  operated_by: string | null;
  effective_to: string | null;
  reporting_only?: boolean;
}

export function getStaticPaths() {
  const entities = registry.entities as Entity[];
  return entities
    .filter((e) => e.type === 'town')
    // Reporting buckets get no page. AOE records residency for pupils whose
    // town is not established against a town named UNKNOWN; publishing that as
    // a Vermont town page would invent a place. It stays in the registry, and
    // in the data files, because other records reference it -- but it is not a
    // town anyone lives in and no membership is awarded to it.
    .filter((e) => !e.reporting_only)
    .map((town) => ({ params: { slug: town.slug.split('/')[1] }, props: { town } }));
}

const { town } = Astro.props as { town: Entity };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const entities = registry.entities as Entity[];

const su = entities.find((e) => e.slug === town.supervisory_union) ?? null;
const district = entities.find((e) => e.slug === town.operated_by) ?? null;
const siblings = entities.filter(
  (e) => e.type === 'town' && e.operated_by === town.operated_by && e.slug !== town.slug,
);

// --- Students who live here ------------------------------------------------
// Town-of-residence ADM from the AOE records-request extract, with the small
// cells AOE withheld shown as the bound they imply and nothing tighter.
const years = subgroups.years as Year[];
const byYear = ((subgroups.towns as Record<string, Record<string, TownYear>>)[town.slug] ?? {}) as Record<
  string,
  TownYear
>;
const hasResidents = years.some((y) => byYear[y.school_year] !== undefined);
/** Years with a delivered row for this town; the table is only worth drawing for these. */
const shownYears = years.filter((y) => {
  const t = byYear[y.school_year];
  return t !== undefined && t.row !== 'not_applicable';
});
const belowFloorYears = years.filter((y) => byYear[y.school_year]?.row === 'below_reporting_floor');

const notApplicable = years.filter((y) => byYear[y.school_year]?.row === 'not_applicable');
const closed = notApplicable.some((y) => (byYear[y.school_year] as { reason?: string }).reason === 'entity_closed');
const anyHidden = years.some((y) => {
  const t = byYear[y.school_year];
  return t !== undefined && t.row !== 'not_applicable' && ROWS.some((r) => 'status' in r.pick(t) && r.pick(t).status === 'suppressed');
});
const preliminaryYears = shownYears.filter((y) => y.preliminary);
const unusableYears = shownYears.filter((y) => y.not_published.length > 0);
---

<Base title={`${titleCase(town.name)} — Vermont School Budgets`}>
  <h1>{titleCase(town.name)}</h1>

  <dl class="facts">
    <dt>Registry ID</dt>
    <dd><code>{town.slug}</code></dd>
    <dt>AOE organization ID</dt>
    <dd><code>{town.aoe_org_id ?? '—'}</code></dd>
    <dt>Supervisory union</dt>
    <dd>
      {su ? <a href={`${base}/su/${slugTail(su.slug)}/`}>{titleCase(su.name)}</a> : '—'}
    </dd>
    <dt>School district</dt>
    <dd>{district ? titleCase(district.name) : '—'}</dd>
  </dl>

  {
    hasResidents && (
      <>
        <h2>Students who live here</h2>
        <p>
          Each year the state counts the public school students who live in {titleCase(town.name)}.
          The count follows the student, not the school. So it includes students who go to school
          in another town, and it leaves out students who come here from somewhere else.
          {shownYears.length > 0 &&
            ' A student who was enrolled for part of the year counts as part of one, which is why some numbers have decimals.'}
        </p>
        {shownYears.length > 0 && (
        <div class="scroll-x">
          <table class="residents">
            <thead>
              <tr>
                <th scope="col">Students</th>
                {years.map((y) => (
                  <th scope="col" class="numeric">
                    {y.count_year}
                    {y.preliminary && <span class="muted"> (may change)</span>}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {ROWS.map((r) => (
                <tr>
                  <th scope="row">{r.label}</th>
                  {years.map((y) => {
                    const t = byYear[y.school_year];
                    if (t === undefined || t.row === 'not_applicable') return <td class="numeric">—</td>;
                    const c = r.pick(t);
                    if ('value' in c) return <td class="numeric">{count(c.value)}</td>;
                    if (c.status === 'not_published') {
                      return (
                        <td class="numeric">
                          <span class="tag not-computable">not usable</span>
                        </td>
                      );
                    }
                    const b = bound(c);
                    return (
                      <td class="numeric">
                        <span class="tag suppressed">hidden</span>
                        {b && <div class="muted">{b}</div>}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        )}
        {belowFloorYears.length > 0 && (
          <p>
            Fewer than 11 students lived in {titleCase(town.name)} in{' '}
            {belowFloorYears.map((y) => y.count_year).join(' and ')}, so the state hid every number
            for {belowFloorYears.length === 1 ? 'that year' : 'those years'}.
          </p>
        )}
        {anyHidden && (
          <p>
            <strong>Hidden</strong> means the state did not give us that number, to protect student
            privacy. The state hides any count under 11. It also hides some bigger counts, so that
            nobody can work out a hidden one by subtracting. Where the rules let us say how big a
            hidden number is, we say so under it.
          </p>
        )}
        {preliminaryYears.map((y) => (
          <p>
            The {y.count_year} numbers <strong>may change</strong>. We asked the state whether
            they are final and had not heard back when this page was built.
          </p>
        ))}
        {unusableYears.map((y) => (
          <p>
            For {y.count_year}, the state's English learner and lunch counts were{' '}
            <strong>not usable</strong>, so we do not show them. The state did not collect the
            English learner flag that year, and it has said its lunch flag was set for nearly every
            student by mistake.
          </p>
        ))}
        {notApplicable.length > 0 && !closed && (
          <p>
            No students were counted as living in {titleCase(town.name)} in{' '}
            {notApplicable.map((y) => y.count_year).join(', ')}.
          </p>
        )}
        {closed && (
          <p>
            This record closed in {town.effective_to?.slice(0, 4)} and no students are counted
            under it. Its students are counted with the town they live in.
          </p>
        )}
      </>
    )
  }

  <h2>Homestead tax rate</h2>
  <div class="notice blocking">
    <strong>Not computed</strong>
    <p>
      A town's billed homestead rate is its district's education spending per weighted pupil,
      divided by the property yield the Legislature sets each year, then divided by the town's
      common level of appraisal. None of those three inputs is available yet: no budget document
      has been collected for this district, and neither the yield nor the pupil weights have been
      verified against current statute.
    </p>
    <p>
      That last step — dividing by the CLA — is usually the least-explained part of a Vermont tax
      bill, and it is frequently the largest reason a bill moved when district spending did not.
      The <a href={`${base}/model/`}>modeling tool</a> shows it as its own step with its own
      explanation.
    </p>
  </div>

  {
    siblings.length > 0 && (
      <>
        <h2>Other towns in the same district ({siblings.length})</h2>
        <p>
          These towns share a district budget with {titleCase(town.name)}, so a change to that
          budget moves all of their rates together — though not by the same amount, because each
          town has its own common level of appraisal.
        </p>
        <ul class="grid">
          {siblings.map((t) => (
            <li class="card">
              <a href={`${base}/town/${slugTail(t.slug)}/`}>{titleCase(t.name)}</a>
            </li>
          ))}
        </ul>
      </>
    )
  }
</Base>
