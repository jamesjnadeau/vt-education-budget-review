{
  "name": "vt-budget-pipeline",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Vermont school budget data pipeline and merger modeling site",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "model",
    "tools",
    "site"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "registry:sync": "tsx tools/src/cli/registry-sync.ts",
    "registry:corrections": "tsx tools/src/cli/registry-corrections.ts",
    "validate": "tsx tools/src/cli/validate.ts",
    "coverage": "tsx tools/src/cli/coverage.ts",
    "adm:import": "tsx tools/src/cli/adm-import.ts",
    "census:import": "tsx tools/src/cli/census-import.ts",
    "school:municipality": "tsx tools/src/cli/school-municipality.ts",
    "collect": "tsx tools/src/cli/collect.ts",
    "intake": "tsx tools/src/cli/intake.ts",
    "normalize": "tsx tools/src/cli/normalize.ts",
    "params": "tsx tools/src/cli/params.ts",
    "build:data": "tsx tools/src/cli/build-data.ts",
    "build:site": "npm run build --workspace site",
    "build": "npm run validate && npm run build:data && npm run build:site",
    "dev": "npm run build:data && npm run dev --workspace site",
    "statute:sync": "tsx tools/src/cli/statute-sync.ts",
    "vt:fetch": "tsx tools/src/cli/vt-fetch.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.23.1",
    "typescript": "6.0.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "read-excel-file": "^9.3.5",
    "yaml": "^2.9.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "sharp@0.34.5": true
  }
}
