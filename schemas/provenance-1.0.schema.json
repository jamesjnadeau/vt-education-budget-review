{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vt-budget:schema:provenance:1.0",
  "title": "Intake artifact provenance",
  "description": "Sits beside every raw artifact in intake/<su-slug>/<fy>/. Raw artifacts are never edited; this file records where each came from and who touched it. Provenance is the product -- when someone asks where a number came from and when it changed, the answer is a commit link.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entity", "fiscal_year", "artifacts"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "entity": { "$ref": "urn:vt-budget:schema:common:1.0#/$defs/entity_ref" },
    "fiscal_year": { "type": "integer", "minimum": 2015, "maximum": 2100 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file", "source_url", "retrieved_date", "retrieval_method", "sha256", "retrieved_by"],
        "properties": {
          "file": {
            "type": "string",
            "description": "Filename within this directory, exactly as released. Never renamed for tidiness."
          },
          "source_url": {
            "type": ["string", "null"],
            "format": "uri",
            "description": "Where it came from. Null only when retrieval_method is 'email' or 'in_person', in which case `note` must explain."
          },
          "retrieved_date": { "type": "string", "format": "date" },
          "retrieval_method": {
            "enum": ["http-fetch", "scrape", "manual-download", "email", "in_person", "foia"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "description": "Hash of the file as retrieved. CI re-verifies this on every PR; a mismatch means the artifact was edited, which is never permitted."
          },
          "bytes": { "type": ["integer", "null"], "minimum": 0, "default": null },
          "media_type": { "type": ["string", "null"], "default": null },
          "retrieved_by": { "type": "string", "minLength": 1 },
          "document_type": {
            "enum": [
              "annual_report",
              "budget_book",
              "town_meeting_warning",
              "board_presentation",
              "spreadsheet",
              "aoe_report",
              "tax_department_report",
              "other"
            ],
            "default": "other"
          },
          "supersedes": {
            "type": ["string", "null"],
            "description": "Filename of an earlier artifact this one replaces, e.g. a revised budget book. The earlier file stays in the repo.",
            "default": null
          },
          "note": { "type": ["string", "null"], "default": null }
        }
      }
    }
  }
}
